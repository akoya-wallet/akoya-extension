{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "__MSG_appShortName__",
  "description": "__MSG_appDesc__",
  "version": "0.2.2",
  "default_locale": "en",
  "homepage_url": "https://github.com/akoya-wallet/akoya-extension",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/akoya-16.png",
    "32": "icons/akoya-32.png",
    "48": "icons/akoya-48.png",
    "128": "icons/akoya-128.png"
  },
  "action": {
    "default_title": "__MSG_appShortName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/akoya-16.png",
      "32": "icons/akoya-32.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://blockbook.pearlresearch.ai/*",
    "https://blockbook.testnet.pearlresearch.ai/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src https:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  }
}
